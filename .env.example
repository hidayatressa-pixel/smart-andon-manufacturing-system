# ==============================================================================
# SMART ANDON MANUFACTURING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Data Provider Mode: Select "demo" for offline-first run or "firebase" for cloud mode
VITE_DATA_PROVIDER=demo

# Firebase Cloud Database Credentials (Only required if VITE_DATA_PROVIDER=firebase)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_ID=(default)

# White-Label Commercial Branding Configurations
VITE_APP_NAME="Smart Andon"
VITE_APP_VERSION="1.0.0"
VITE_APP_COMPANY="Your Company"
VITE_APP_LOGO_URL=""

# Telegram Bot Notifications (Optional)
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI Studio / Backend server configurations
APP_URL="http://localhost:3000"
NODE_ENV=development
